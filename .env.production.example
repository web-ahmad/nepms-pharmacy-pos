# Pharvix — production environment.
#
#   cp .env.production.example .env.production
#   nano .env.production          # fill in the real values
#   docker compose --env-file .env.production up -d --build
#
# .env.production holds live secrets. It is git-ignored and must never be
# committed. Keep a copy somewhere safe — it is not recoverable from the server
# alone if the instance is lost.

# --- Database (Supabase session pooler, port 5432) ---------------------------
# Supabase dashboard > Project Settings > Database > Connection string > Session pooler.
# The app forces sslmode=require and normalises the scheme by itself.
# Note: Supabase caps the session pooler at 15 clients for the whole project;
# database.py keeps the app at 10 so a migration script can still connect.
DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

SUPABASE_URL=https://PROJECTREF.supabase.co
SUPABASE_KEY=sb_publishable_XXXXXXXXXXXX

# --- Auth --------------------------------------------------------------------
# Generate a fresh one, do not reuse the development value:
#   openssl rand -hex 32
SECRET_KEY=CHANGE_ME
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Public URL --------------------------------------------------------------
BACKEND_URL=https://pharvix.devjix.com
# Only needed if the frontend is ever served from a different origin than the
# API. With this docker-compose setup nginx serves both, so leave it empty.
CORS_ORIGINS=

# --- Integrations ------------------------------------------------------------
GEMINI_API_KEY=
TEST_WHATSAPP_NUMBER=
WHATSAPP_BOT_WHITELIST=

# --- App behaviour -----------------------------------------------------------
POS_WORKFLOW_MODE=DUAL
